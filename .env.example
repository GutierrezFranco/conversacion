# URL pública de la app (sin barra final). En local: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Datos públicos del negocio (se muestran en contacto, términos y pie de página)
NEXT_PUBLIC_CONTACT_EMAIL=hola@edicionsimple.com.ar
# Opcional: WhatsApp del negocio, con código de país y sin "+" (ej: 5491112345678)
NEXT_PUBLIC_SUPPORT_WHATSAPP=
NEXT_PUBLIC_LEGAL_NAME=Edición Simple
# Mails que ven el panel de administración (/app/admin), separados por coma
ADMIN_EMAILS=

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor y worker. Nunca la expongas en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Dónde se guardan los videos: "supabase" (por defecto) o "r2" (Cloudflare R2, 10 GB gratis)
STORAGE_PROVIDER=supabase
# Solo si STORAGE_PROVIDER=r2 (Cloudflare → R2 → Manage API tokens)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=edicion-simple

# Mercado Pago (Tus integraciones → Credenciales). Empezá con las de prueba.
MP_ACCESS_TOKEN=
# Webhooks → Clave secreta, para validar la firma x-signature
MP_WEBHOOK_SECRET=

# Edición (worker)
ANTHROPIC_API_KEY=
# Transcripción: "elevenlabs" (más precisa, paga) o "whisper" (gratis, corre en el worker)
TRANSCRIBER=elevenlabs
ELEVENLABS_API_KEY=
# Solo con TRANSCRIBER=whisper fuera de Docker (en Docker ya vienen configuradas)
# WHISPER_BIN=whisper-cli
# WHISPER_MODEL=/ruta/a/ggml-small.bin
# Motor premium (HyperFrames): ruta a Chrome/Chromium. En Docker ya viene configurado.
# HYPERFRAMES_BROWSER_PATH=/usr/bin/chromium
HYPERFRAMES_NO_TELEMETRY=1
# Cuántos videos procesa el worker a la vez
WORKER_CONCURRENCY=2

# Opcional: generadores de imágenes y videos con IA (apagados por defecto)
NEXT_PUBLIC_AI_GENERATORS=0
FAL_KEY=
# Cotización para pasar a pesos lo que cuestan los generadores en dólares
ARS_PER_USD=1450
