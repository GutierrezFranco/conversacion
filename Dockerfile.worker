# Worker de Edición Simple: procesa ediciones, imágenes y videos.
# Corre en cualquier máquina con Docker (una notebook, un VPS, Railway, Fly.io…): no necesita puerto público.

# ---- Whisper (transcripción gratis, opcional: TRANSCRIBER=whisper) ----
FROM debian:bookworm-slim AS whisper
ARG WHISPER_VERSION=v1.9.5
# small-q5_1: el modelo small comprimido; casi la misma precisión en español con un tercio de la memoria,
# para que entre en servidores chicos. base es más liviano y menos preciso.
ARG WHISPER_MODEL=small-q5_1
# Sin GGML_NATIVE el binario no depende del procesador de la máquina que lo compila (en Railway o Fly
# se compila en una y corre en otra). AVX2 lo tiene cualquier servidor de los últimos 10 años.
RUN apt-get update && apt-get install -y --no-install-recommends git cmake build-essential ca-certificates curl \
  && git clone --depth 1 --branch $WHISPER_VERSION https://github.com/ggml-org/whisper.cpp /src \
  && cmake -S /src -B /src/build -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF -DWHISPER_BUILD_TESTS=OFF \
     -DGGML_NATIVE=OFF -DGGML_AVX=ON -DGGML_AVX2=ON -DGGML_FMA=ON -DGGML_F16C=ON \
  && cmake --build /src/build -j --target whisper-cli \
  && mkdir -p /opt/whisper && cp /src/build/bin/whisper-cli /opt/whisper/ \
  && curl -fsSL -o /opt/whisper/ggml-$WHISPER_MODEL.bin https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-$WHISPER_MODEL.bin

FROM node:22-slim

# chromium: lo usa HyperFrames (motor premium) para dibujar subtítulos y plantillas animados.
RUN apt-get update \
  && apt-get install -y --no-install-recommends ffmpeg fontconfig ca-certificates curl chromium \
  && rm -rf /var/lib/apt/lists/*

ENV HYPERFRAMES_BROWSER_PATH=/usr/bin/chromium \
    HYPERFRAMES_NO_TELEMETRY=1 \
    PUPPETEER_SKIP_DOWNLOAD=1

COPY --from=whisper /opt/whisper /opt/whisper
ENV WHISPER_BIN=/opt/whisper/whisper-cli \
    WHISPER_MODEL=/opt/whisper/ggml-small-q5_1.bin

# Tipografías que usan los estilos y las referencias. Tiene que coincidir con lib/fonts.ts.
ENV FONTS_DIR=/usr/share/fonts/edicion
RUN mkdir -p $FONTS_DIR && cd $FONTS_DIR \
  && for f in \
       ofl/poppins/Poppins-Medium.ttf ofl/poppins/Poppins-SemiBold.ttf ofl/poppins/Poppins-Bold.ttf ofl/poppins/Poppins-ExtraBold.ttf \
       ofl/anton/Anton-Regular.ttf ofl/bebasneue/BebasNeue-Regular.ttf ofl/archivoblack/ArchivoBlack-Regular.ttf \
       ofl/kanit/Kanit-Bold.ttf ofl/kanit/Kanit-ExtraBoldItalic.ttf ofl/bangers/Bangers-Regular.ttf \
       ofl/lilitaone/LilitaOne-Regular.ttf ofl/titanone/TitanOne-Regular.ttf apache/permanentmarker/PermanentMarker-Regular.ttf \
       ofl/caveatbrush/CaveatBrush-Regular.ttf ofl/dmserifdisplay/DMSerifDisplay-Regular.ttf; \
     do curl -fsSLO https://raw.githubusercontent.com/google/fonts/main/$f; done \
  && fc-cache -f

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm install --no-save tsx
# Parakeet (TRANSCRIBER=parakeet): modelo de voz de NVIDIA que corre acá mismo, gratis. Pesa ~700 MB.
RUN npx hyperframes models install parakeet
COPY lib ./lib
COPY worker ./worker
COPY tsconfig.json ./

CMD ["npx", "tsx", "worker/index.ts"]
